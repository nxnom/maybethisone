{
  "name": "maybethisone",
  "version": "0.1.0",
  "description": "Check availability of GitHub orgs, npm packages, social media handles, and domains",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "maybethisone": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "search": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external playwright --external chalk --external cli-table3",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "publish:beta": "npm publish --tag beta",
    "publish:alpha": "npm publish --tag alpha",
    "publish:next": "npm publish --tag next",
    "publish:latest": "npm publish --tag latest",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "bun run build && npm publish",
    "release:beta": "bun run build && npm publish --tag beta",
    "release:dry": "bun run build && npm publish --dry-run"
  },
  "keywords": [
    "availability",
    "checker",
    "github",
    "npm",
    "domain",
    "twitter",
    "linkedin",
    "cli",
    "maybethisone"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0"
  }
}
